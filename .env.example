# Optional LLM for feedback on any topic
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...

# Hybrid RAG (retrieval-augmented feedback)
RAG_ENABLED=true
RAG_PHASE=1
RAG_MIGRATE_ON_START=true
RAG_DEBUG_META=false

# Embeddings (uses OPENAI_API_KEY when set; otherwise sparse/BM25 only)
# EMBEDDING_MODEL=text-embedding-3-small

# Tuning
# RAG_FINAL_K=12
# RAG_TOKEN_BUDGET=2800
# RRF_K=60

# Server
PORT=8787
