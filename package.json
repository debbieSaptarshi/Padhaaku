{
  "name": "padhaaku",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Your study buddy that helps you understand any topic through active recall on a canvas.",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"npm:server\"",
    "server": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "preview": "node server/index.mjs",
    "start": "NODE_ENV=production node server/index.mjs",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "typescript": "^5.5.3",
    "vite": "^5.4.0"
  }
}
